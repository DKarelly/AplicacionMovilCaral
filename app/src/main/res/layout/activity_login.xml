<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/productGridBackgroundColor"
    tools:context=".LoginActivity">


    <!-- Círculo superior derecho -->
    <View
        android:id="@+id/top_blob"
        android:layout_width="245dp"
        android:layout_height="245dp"
        android:layout_marginTop="-45dp"
        android:layout_marginEnd="-45dp"
        android:background="@drawable/bg_login_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Círculo lateral izquierdo -->
    <View
        android:id="@+id/second_blob"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginStart="-105dp"
        android:layout_marginTop="160dp"
        android:alpha="0.55"
        android:background="@drawable/bg_login_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- Icono de IncidentApp -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/icon_card"
        android:layout_marginHorizontal="32dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="55dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="17dp"
        app:cardElevation="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_gravity="center"
            android:contentDescription="IncidentApp"
            android:src="@drawable/ic_tool_simple"
            app:tint="@android:color/white" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Título con dos colores desde Java -->
    <TextView
        android:id="@+id/login_title"
        android:layout_marginHorizontal="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:letterSpacing="-0.025"
        android:text="IncidentApp"
        android:textColor="@color/textPrimary"
        android:textSize="31sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icon_card" />

    <TextView
        android:id="@+id/login_subtitle"
        android:layout_marginHorizontal="32dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans"
        android:lineSpacingExtra="4dp"
        android:text="Gestiona los incidentes TI de tu empresa, donde estés."
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_title" />

    <!-- Correo o usuario -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/username_text_input"
        android:layout_marginHorizontal="32dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="37dp"
        android:hint="Correo electrónico"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusTopStart="15dp"
        app:boxCornerRadiusTopEnd="15dp"
        app:boxCornerRadiusBottomStart="15dp"
        app:boxCornerRadiusBottomEnd="15dp"
        app:boxStrokeColor="@color/softBorder"
        app:boxStrokeWidth="1dp"
        app:expandedHintEnabled="false"
        app:hintTextColor="@color/colorPrimary"
        app:placeholderText="nombre@empresa.com"
        app:placeholderTextColor="@color/textSecondary"
        app:startIconDrawable="@drawable/ic_login_mail"
        app:startIconTint="@color/textSecondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_subtitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/username_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Contraseña -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/password_text_input"
        android:layout_marginHorizontal="32dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Contraseña"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusTopStart="15dp"
        app:boxCornerRadiusTopEnd="15dp"
        app:boxCornerRadiusBottomStart="15dp"
        app:boxCornerRadiusBottomEnd="15dp"
        app:boxStrokeColor="@color/softBorder"
        app:boxStrokeWidth="1dp"
        app:expandedHintEnabled="false"
        app:hintTextColor="@color/colorPrimary"
        app:placeholderText="••••••••"
        app:placeholderTextColor="@color/textSecondary"
        app:startIconDrawable="@drawable/ic_login_lock"
        app:startIconTint="@color/textSecondary"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/textSecondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/username_text_input">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:inputType="textPassword"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Recuperar contraseña -->
    <TextView
        android:id="@+id/txt_forgot"
        android:layout_marginHorizontal="32dp"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical|end"
        android:paddingStart="8dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans"
        android:text="¿Olvidaste tu contraseña?"
        android:textColor="@color/colorPrimary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/password_text_input" />

    <!-- Mensajes del servidor -->
    <TextView
        android:id="@+id/txtRptaJson"
        android:layout_marginHorizontal="32dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans"
        android:textColor="@color/textDanger"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_forgot" />



    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_button"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:text="Ingresar"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:elevation="5dp"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/txtRptaJson"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Pie de página -->

    <TextView
        android:id="@+id/footer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans"
        android:text="Acceso exclusivo para colaboradores"
        android:textColor="@color/textSecondary"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/next_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
