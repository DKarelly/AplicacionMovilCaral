<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/productGridBackgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- ESCANEAR EQUIPO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_escanear_equipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/colorPrimary"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_tool_simple"
                    app:tint="@color/white"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Escanear equipo"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/txt_estado_activo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Identifica el activo con QR · Toca para escanear"
                        android:textColor="@color/white"
                        android:textSize="12sp"/>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TÍTULO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/titulo_incident_text_input"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Título del incidente"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusTopStart="17dp"
            app:boxCornerRadiusTopEnd="17dp"
            app:boxCornerRadiusBottomStart="17dp"
            app:boxCornerRadiusBottomEnd="17dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/titulo_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="textCapSentences"
                android:maxLines="1"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- DESCRIPCIÓN -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/descripcion_incident_text_input"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Descripción detallada"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusTopStart="17dp"
            app:boxCornerRadiusTopEnd="17dp"
            app:boxCornerRadiusBottomStart="17dp"
            app:boxCornerRadiusBottomEnd="17dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/descripcion_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:minLines="3"
                android:gravity="top|start"
                android:inputType="textMultiLine"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CATEGORÍA -->
        <TextView
            android:id="@+id/lblCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Categoría"
            android:textSize="12sp"
            android:textColor="@color/colorPrimary"/>

        <Spinner
            android:id="@+id/categoria_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"/>

        <!-- OTRA CATEGORÍA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/categoria_custom_input"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Especificar otra categoría"
            android:visibility="gone"
            app:boxBackgroundColor="@color/white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/categoria_custom_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- PRIORIDAD -->
        <TextView
            android:id="@+id/lblPrioridad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Prioridad"
            android:textSize="12sp"
            android:textColor="@color/colorPrimary"/>

        <Spinner
            android:id="@+id/prioridad_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"/>

        <!-- SUCURSAL -->
        <TextView
            android:id="@+id/lblSucursal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Sucursal"
            android:textSize="12sp"
            android:textColor="@color/colorPrimary"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/sucursal_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ir_registrar_sucursal"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:visibility="gone"
                android:text="Nueva"
                android:textAllCaps="false"
                app:cornerRadius="18dp"/>

        </LinearLayout>


        <!-- FOTOGRAFÍAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fotos adjuntas"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/fotos_contador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 2"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/fotos_preview_container"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <!-- BOTÓN AGREGAR FOTOGRAFÍA -->
            <LinearLayout
                android:id="@+id/btn_agregar_foto"
                android:layout_width="76dp"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_photo_add"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icono_agregar_foto"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#91A6B3"/>

                <TextView
                    android:id="@+id/txt_agregar_foto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Añadir"
                    android:textColor="#91A6B3"
                    android:textSize="10sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ENVIAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_incident_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="Enviar incidente"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/colorPrimary"/>

        <!-- CANCELAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_add_incident_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
