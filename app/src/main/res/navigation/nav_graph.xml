<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/IncidentListFragment">

    <fragment
        android:id="@+id/HomeFragment"
        android:name="com.example.py_damb2026ii.HomeFragment"
        android:label="Bienvenido"
        tools:layout="@layout/fragment_home">
    </fragment>

    <fragment
        android:id="@+id/AddDiscFragment"
        android:name="com.example.py_damb2026ii.AddDiscFragment"
        android:label="Agregar disco"
        tools:layout="@layout/fragment_add_disc">
    </fragment>

    <fragment
        android:id="@+id/AddIncidentFragment"
        android:name="com.example.py_damb2026ii.AddIncidentFragment"
        android:label="Registrar Incidente"
        tools:layout="@layout/fragment_add_incident">
    </fragment>

    <fragment
        android:id="@+id/IncidentListFragment"
        android:name="com.example.py_damb2026ii.IncidentListFragment"
        android:label="Lista de Incidentes"
        tools:layout="@layout/fragment_incident_list">
    </fragment>

    <fragment
        android:id="@+id/AdminReportsFragment"
        android:name="com.example.py_damb2026ii.AdminReportsFragment"
        android:label="Reportes y Métricas"
        tools:layout="@layout/fragment_admin_reports">
    </fragment>

    <fragment
        android:id="@+id/TecnicoHomeFragment"
        android:name="com.example.py_damb2026ii.TecnicoHomeFragment"
        android:label="Vista del Técnico"
        tools:layout="@layout/fragment_tecnico_home">
    </fragment>

    <fragment
        android:id="@+id/SolicitanteHomeFragment"
        android:name="com.example.py_damb2026ii.SolicitanteHomeFragment"
        android:label="Vista del Solicitante"
        tools:layout="@layout/fragment_solicitante_home">
    </fragment>

    <fragment
        android:id="@+id/IncidentConfirmationFragment"
        android:name="com.example.py_damb2026ii.IncidentConfirmationFragment"
        android:label="Confirmación"
        tools:layout="@layout/fragment_incident_confirmation">
    </fragment>


    <fragment
        android:id="@+id/IncidentDetailFragment"
        android:name="com.example.py_damb2026ii.IncidentDetailFragment"
        android:label="Detalle del Incidente"
        tools:layout="@layout/fragment_incident_detail">

        <argument
            android:name="id_incidente"
            app:argType="integer" />

    </fragment>


    <fragment
        android:id="@+id/AddBranchFragment"
        android:name="com.example.py_damb2026ii.AddBranchFragment"
        android:label="Registrar Sucursal"
        tools:layout="@layout/fragment_add_branch">
    </fragment>

    <fragment
        android:id="@+id/BranchListFragment"
        android:name="com.example.py_damb2026ii.BranchListFragment"
        android:label="Lista de Sucursales"
        tools:layout="@layout/fragment_branch_list">
    </fragment>

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.py_damb2026ii.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.py_damb2026ii.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
        <argument
            android:name="myArg"
            app:argType="integer" />
    </fragment>
</navigation>